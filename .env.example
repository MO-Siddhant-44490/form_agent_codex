# Copy this file to `.env` (in the repo root) and fill in ONE model option.
# The backend reads .env at startup; .env is git-ignored, so keys stay local.

# --- Option A: OpenAI (simplest) -----------------------------------------
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1          # any chat model that accepts images + PDFs
# OPENAI_BASE_URL=https://api.openai.com/v1   # or an OpenAI-compatible API

# --- Option B: Claude on Amazon Bedrock ----------------------------------
# MODEL_PROVIDER=bedrock
# AWS_PROFILE=your-profile
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-20250514-v1:0

# --- Option C: a local model server (Ollama, vLLM, LM Studio) ------------
# MODEL_PROVIDER=local
# LOCAL_MODEL_URL=http://localhost:11434/v1
# LOCAL_MODEL_ID=llama3.1

# --- Option D: no model, offline demo -------------------------------------
# MODEL_PROVIDER=fake

# --- Optional ---------------------------------------------------------------
# PORT=8000                     # if you change it, the extension must match
