  "dependencies": {
    "@form-agent/contracts": "workspace:*",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "@types/chrome": "^0.0.287",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
