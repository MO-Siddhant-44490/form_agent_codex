{
  "$defs": {
    "DialogInfo": {
      "additionalProperties": false,
      "properties": {
        "contains_form": {
          "default": false,
          "title": "Contains Form",
          "type": "boolean"
        },
        "dialog_id": {
          "title": "Dialog Id",
          "type": "string"
        },
        "dismiss_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/DialogKind"
        },
        "text_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Snippet"
        }
      },
      "required": [
        "dialog_id",
        "kind"
      ],
      "title": "DialogInfo",
      "type": "object"
    },
    "DialogKind": {
      "enum": [
        "cookie_banner",
        "modal",
        "alert",
        "other"
      ],
      "title": "DialogKind",
      "type": "string"
    },
    "FieldPurpose": {
      "description": "What a control is FOR, beyond its input type. Perception classifies it\nfrom the control's own text (label, name, placeholder, autocomplete) so the\nbackend can apply the right rule without site-specific knowledge:\n\n- STANDARD: an ordinary data field, fillable from facts. Includes masked\n  identifiers (an Aadhaar/PAN/account number rendered as a password-type\n  input) \u2014 their VALUE stays redacted, but they are not login secrets.\n- CREDENTIAL: a password / OTP / PIN / card secret. Never read, never\n  written (invariant 2); the human enters it on the page.\n- CAPTCHA: a human-only challenge (text captcha box). Never written.\n- CONSENT: a declaration/consent control (\"I consent to\u2026\"). Only set on the\n  user's explicit say-so, never inferred from a profile.",
      "enum": [
        "standard",
        "credential",
        "captcha",
        "consent"
      ],
      "title": "FieldPurpose",
      "type": "string"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Value"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "title": "Input Type",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "max_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Length"
        },
        "nearby_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearby Text"
        },
        "option_labels": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Option Labels"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "purpose": {
          "$ref": "#/$defs/FieldPurpose",
          "default": "standard"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/TargetDescriptor"
        },
        "validation_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Message"
        },
        "value_length": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Length"
        },
        "value_redacted": {
          "default": false,
          "title": "Value Redacted",
          "type": "boolean"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "field_id",
        "target",
        "input_type"
      ],
      "title": "FormField",
      "type": "object"
    },
    "FrameInfo": {
      "additionalProperties": false,
      "properties": {
        "accessible": {
          "title": "Accessible",
          "type": "boolean"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "origin",
        "accessible"
      ],
      "title": "FrameInfo",
      "type": "object"
    },
    "NavigationControl": {
      "additionalProperties": false,
      "description": "A control that advances, reverses, or submits a multi-step form.",
      "properties": {
        "control_id": {
          "title": "Control Id",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/NavigationKind"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "target": {
          "$ref": "#/$defs/TargetDescriptor"
        }
      },
      "required": [
        "control_id",
        "kind",
        "target"
      ],
      "title": "NavigationControl",
      "type": "object"
    },
    "NavigationKind": {
      "enum": [
        "next",
        "previous",
        "submit"
      ],
      "title": "NavigationKind",
      "type": "string"
    },
    "PageClass": {
      "enum": [
        "form",
        "login",
        "mfa",
        "captcha",
        "confirmation",
        "error",
        "cookie_banner",
        "other"
      ],
      "title": "PageClass",
      "type": "string"
    },
    "PageClassCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/PageClass"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "PageClassCandidate",
      "type": "object"
    },
    "TargetDescriptor": {
      "additionalProperties": false,
      "description": "Resilient semantic locator for a form control (plan.md \u00a79).",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autocomplete"
        },
        "bounding_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounding Box"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name_attr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Attr"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "role"
      ],
      "title": "TargetDescriptor",
      "type": "object"
    },
    "UnrecognizedControl": {
      "additionalProperties": false,
      "description": "An interactive element perception can SEE but cannot operate (a role\nwith no executor, or a click-driven element with no role). Reported so the\nagent can say \"I see X but can't fill it\" instead of skipping silently.",
      "properties": {
        "name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "role"
      ],
      "title": "UnrecognizedControl",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captcha_detected": {
      "default": false,
      "title": "Captcha Detected",
      "type": "boolean"
    },
    "classification": {
      "items": {
        "$ref": "#/$defs/PageClassCandidate"
      },
      "title": "Classification",
      "type": "array"
    },
    "dialogs": {
      "items": {
        "$ref": "#/$defs/DialogInfo"
      },
      "title": "Dialogs",
      "type": "array"
    },
    "dom_stable": {
      "default": true,
      "title": "Dom Stable",
      "type": "boolean"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FormField"
      },
      "title": "Fields",
      "type": "array"
    },
    "frame_id": {
      "default": "main",
      "title": "Frame Id",
      "type": "string"
    },
    "iframes": {
      "items": {
        "$ref": "#/$defs/FrameInfo"
      },
      "title": "Iframes",
      "type": "array"
    },
    "login_detected": {
      "default": false,
      "title": "Login Detected",
      "type": "boolean"
    },
    "navigation": {
      "items": {
        "$ref": "#/$defs/NavigationControl"
      },
      "title": "Navigation",
      "type": "array"
    },
    "observation_seq": {
      "minimum": 0,
      "title": "Observation Seq",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "page_fingerprint": {
      "title": "Page Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "step_label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Step Label"
    },
    "tab_id": {
      "title": "Tab Id",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "unrecognized_controls": {
      "items": {
        "$ref": "#/$defs/UnrecognizedControl"
      },
      "title": "Unrecognized Controls",
      "type": "array"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tab_id",
    "url",
    "origin",
    "page_fingerprint",
    "observation_seq",
    "observed_at"
  ],
  "title": "PageObservation",
  "type": "object",
  "x-protocol-version": "1.0"
}
