{
  "$defs": {
    "DialogInfo": {
      "additionalProperties": false,
      "properties": {
        "dialog_id": {
          "title": "Dialog Id",
          "type": "string"
        },
        "dismiss_target": {
          "anyOf": [
            {
              "$ref": "#/$defs/TargetDescriptor"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "$ref": "#/$defs/DialogKind"
        },
        "text_snippet": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Text Snippet"
        }
      },
      "required": [
        "dialog_id",
        "kind"
      ],
      "title": "DialogInfo",
      "type": "object"
    },
    "DialogKind": {
      "enum": [
        "cookie_banner",
        "modal",
        "alert",
        "other"
      ],
      "title": "DialogKind",
      "type": "string"
    },
    "FormField": {
      "additionalProperties": false,
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "checked": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Checked"
        },
        "current_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Value"
        },
        "disabled": {
          "default": false,
          "title": "Disabled",
          "type": "boolean"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "title": "Input Type",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "nearby_text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nearby Text"
        },
        "options": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Options"
        },
        "readonly": {
          "default": false,
          "title": "Readonly",
          "type": "boolean"
        },
        "required": {
          "default": false,
          "title": "Required",
          "type": "boolean"
        },
        "target": {
          "$ref": "#/$defs/TargetDescriptor"
        },
        "validation_message": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Validation Message"
        },
        "value_redacted": {
          "default": false,
          "title": "Value Redacted",
          "type": "boolean"
        },
        "visible": {
          "default": true,
          "title": "Visible",
          "type": "boolean"
        }
      },
      "required": [
        "field_id",
        "target",
        "input_type"
      ],
      "title": "FormField",
      "type": "object"
    },
    "FrameInfo": {
      "additionalProperties": false,
      "properties": {
        "accessible": {
          "title": "Accessible",
          "type": "boolean"
        },
        "frame_id": {
          "title": "Frame Id",
          "type": "string"
        },
        "origin": {
          "title": "Origin",
          "type": "string"
        }
      },
      "required": [
        "frame_id",
        "origin",
        "accessible"
      ],
      "title": "FrameInfo",
      "type": "object"
    },
    "PageClass": {
      "enum": [
        "form",
        "login",
        "mfa",
        "captcha",
        "confirmation",
        "error",
        "cookie_banner",
        "other"
      ],
      "title": "PageClass",
      "type": "string"
    },
    "PageClassCandidate": {
      "additionalProperties": false,
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "label": {
          "$ref": "#/$defs/PageClass"
        }
      },
      "required": [
        "label",
        "confidence"
      ],
      "title": "PageClassCandidate",
      "type": "object"
    },
    "TargetDescriptor": {
      "additionalProperties": false,
      "description": "Resilient semantic locator for a form control (plan.md \u00a79).",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autocomplete"
        },
        "bounding_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounding Box"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name_attr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Attr"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "role"
      ],
      "title": "TargetDescriptor",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "captcha_detected": {
      "default": false,
      "title": "Captcha Detected",
      "type": "boolean"
    },
    "classification": {
      "items": {
        "$ref": "#/$defs/PageClassCandidate"
      },
      "title": "Classification",
      "type": "array"
    },
    "dialogs": {
      "items": {
        "$ref": "#/$defs/DialogInfo"
      },
      "title": "Dialogs",
      "type": "array"
    },
    "dom_stable": {
      "default": true,
      "title": "Dom Stable",
      "type": "boolean"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FormField"
      },
      "title": "Fields",
      "type": "array"
    },
    "frame_id": {
      "default": "main",
      "title": "Frame Id",
      "type": "string"
    },
    "iframes": {
      "items": {
        "$ref": "#/$defs/FrameInfo"
      },
      "title": "Iframes",
      "type": "array"
    },
    "login_detected": {
      "default": false,
      "title": "Login Detected",
      "type": "boolean"
    },
    "observation_seq": {
      "minimum": 0,
      "title": "Observation Seq",
      "type": "integer"
    },
    "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
    },
    "origin": {
      "title": "Origin",
      "type": "string"
    },
    "page_fingerprint": {
      "title": "Page Fingerprint",
      "type": "string"
    },
    "run_id": {
      "title": "Run Id",
      "type": "string"
    },
    "tab_id": {
      "title": "Tab Id",
      "type": "integer"
    },
    "title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Title"
    },
    "url": {
      "title": "Url",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "tab_id",
    "url",
    "origin",
    "page_fingerprint",
    "observation_seq",
    "observed_at"
  ],
  "title": "PageObservation",
  "type": "object",
  "x-protocol-version": "1.0"
}
