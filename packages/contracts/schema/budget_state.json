{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hard caps that force termination with a classified outcome (invariant 12).",
  "properties": {
    "max_model_calls": {
      "exclusiveMinimum": 0,
      "title": "Max Model Calls",
      "type": "integer"
    },
    "max_retries_per_action": {
      "exclusiveMinimum": 0,
      "title": "Max Retries Per Action",
      "type": "integer"
    },
    "max_steps": {
      "exclusiveMinimum": 0,
      "title": "Max Steps",
      "type": "integer"
    },
    "max_wall_clock_seconds": {
      "exclusiveMinimum": 0,
      "title": "Max Wall Clock Seconds",
      "type": "integer"
    },
    "model_calls_used": {
      "default": 0,
      "minimum": 0,
      "title": "Model Calls Used",
      "type": "integer"
    },
    "steps_used": {
      "default": 0,
      "minimum": 0,
      "title": "Steps Used",
      "type": "integer"
    }
  },
  "required": [
    "max_steps",
    "max_retries_per_action",
    "max_model_calls",
    "max_wall_clock_seconds"
  ],
  "title": "BudgetState",
  "type": "object",
  "x-protocol-version": "1.0"
}
