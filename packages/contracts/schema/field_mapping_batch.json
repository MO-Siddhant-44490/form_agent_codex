{
  "$defs": {
    "FieldMapping": {
      "additionalProperties": false,
      "description": "One proposed field->fact assignment. Three valid shapes:\n- mapped: `fact_key` set (optionally with `selected_option_value` for an\n  enumerated control; it must exist among the field's observed options or\n  policy discards the mapping);\n- clarify: `fact_key` null and `needs_clarification` true (ambiguous, low\n  confidence, or missing fact);\n- skip: `fact_key` null and `needs_clarification` false (deliberately not\n  filled \u2014 e.g. a credential field the model correctly refuses to map).\nA skip yields no assignment and no question; the deterministic mapper and\npolicy gate remain the enforcement points regardless.",
      "properties": {
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "fact_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fact Key"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "needs_clarification": {
          "default": false,
          "title": "Needs Clarification",
          "type": "boolean"
        },
        "reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "selected_option_value": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Option Value"
        }
      },
      "required": [
        "field_id",
        "confidence"
      ],
      "title": "FieldMapping",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "mappings": {
      "items": {
        "$ref": "#/$defs/FieldMapping"
      },
      "title": "Mappings",
      "type": "array"
    }
  },
  "title": "FieldMappingBatch",
  "type": "object",
  "x-protocol-version": "1.0"
}
