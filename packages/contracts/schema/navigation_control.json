{
  "$defs": {
    "NavigationKind": {
      "enum": [
        "next",
        "previous",
        "submit"
      ],
      "title": "NavigationKind",
      "type": "string"
    },
    "TargetDescriptor": {
      "additionalProperties": false,
      "description": "Resilient semantic locator for a form control (plan.md \u00a79).",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autocomplete"
        },
        "bounding_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounding Box"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name_attr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Attr"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "role"
      ],
      "title": "TargetDescriptor",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A control that advances, reverses, or submits a multi-step form.",
  "properties": {
    "control_id": {
      "title": "Control Id",
      "type": "string"
    },
    "kind": {
      "$ref": "#/$defs/NavigationKind"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "target": {
      "$ref": "#/$defs/TargetDescriptor"
    }
  },
  "required": [
    "control_id",
    "kind",
    "target"
  ],
  "title": "NavigationControl",
  "type": "object",
  "x-protocol-version": "1.0"
}
