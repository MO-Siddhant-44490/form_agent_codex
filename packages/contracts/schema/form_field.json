{
  "$defs": {
    "FieldPurpose": {
      "description": "What a control is FOR, beyond its input type. Perception classifies it\nfrom the control's own text (label, name, placeholder, autocomplete) so the\nbackend can apply the right rule without site-specific knowledge:\n\n- STANDARD: an ordinary data field, fillable from facts. Includes masked\n  identifiers (an Aadhaar/PAN/account number rendered as a password-type\n  input) \u2014 their VALUE stays redacted, but they are not login secrets.\n- CREDENTIAL: a password / OTP / PIN / card secret. Never read, never\n  written (invariant 2); the human enters it on the page.\n- CAPTCHA: a human-only challenge (text captcha box). Never written.\n- CONSENT: a declaration/consent control (\"I consent to\u2026\"). Only set on the\n  user's explicit say-so, never inferred from a profile.",
      "enum": [
        "standard",
        "credential",
        "captcha",
        "consent"
      ],
      "title": "FieldPurpose",
      "type": "string"
    },
    "TargetDescriptor": {
      "additionalProperties": false,
      "description": "Resilient semantic locator for a form control (plan.md \u00a79).",
      "properties": {
        "accessible_name": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Accessible Name"
        },
        "autocomplete": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Autocomplete"
        },
        "bounding_box": {
          "anyOf": [
            {
              "maxItems": 4,
              "minItems": 4,
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Bounding Box"
        },
        "field_id": {
          "title": "Field Id",
          "type": "string"
        },
        "input_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Type"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "name_attr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Attr"
        },
        "placeholder": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Placeholder"
        },
        "role": {
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "field_id",
        "role"
      ],
      "title": "TargetDescriptor",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "accessible_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Accessible Name"
    },
    "checked": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Checked"
    },
    "current_value": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Value"
    },
    "disabled": {
      "default": false,
      "title": "Disabled",
      "type": "boolean"
    },
    "field_id": {
      "title": "Field Id",
      "type": "string"
    },
    "input_type": {
      "title": "Input Type",
      "type": "string"
    },
    "label": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Label"
    },
    "max_length": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Length"
    },
    "nearby_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Nearby Text"
    },
    "option_labels": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Option Labels"
    },
    "options": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Options"
    },
    "purpose": {
      "$ref": "#/$defs/FieldPurpose",
      "default": "standard"
    },
    "readonly": {
      "default": false,
      "title": "Readonly",
      "type": "boolean"
    },
    "required": {
      "default": false,
      "title": "Required",
      "type": "boolean"
    },
    "target": {
      "$ref": "#/$defs/TargetDescriptor"
    },
    "validation_message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Validation Message"
    },
    "value_length": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Value Length"
    },
    "value_redacted": {
      "default": false,
      "title": "Value Redacted",
      "type": "boolean"
    },
    "visible": {
      "default": true,
      "title": "Visible",
      "type": "boolean"
    }
  },
  "required": [
    "field_id",
    "target",
    "input_type"
  ],
  "title": "FormField",
  "type": "object",
  "x-protocol-version": "1.0"
}
